<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HorizonShopping.Maui.EditProductPage"
    Title="Editar producto">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Editar producto"
                FontSize="30"
                HorizontalOptions="Center" />

            <Label
                Text="Nombre del producto"
                FontSize="18" />

            <Entry
                x:Name="txtNombre"
                Placeholder="Introduce el nombre" />

            <Label
                Text="Cantidad"
                FontSize="18" />

            <Entry
                x:Name="txtCantidad"
                Placeholder="Introduce la cantidad"
                Keyboard="Numeric" />

            <Label
                Text="Sección"
                FontSize="18" />

            <Picker
                x:Name="cmbSeccion"
                Title="Selecciona una sección" />

            <Button
                Text="Guardar cambios"
                Clicked="OnGuardarCambiosClicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>